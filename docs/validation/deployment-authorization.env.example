# REFERENCE ONLY. Do not source this file or place real secrets here.
# Select isolated test values only after decisions and deployment authorization.
LAB_AUTH_MODE=oidc
LAB_EXPOSE_DOCS=0
LAB_ALLOW_INSECURE_LOCAL_AUTH=0
LAB_DATABASE_URL=__INJECT_DEDICATED_TEST_POSTGRES_URL_AT_RUNTIME__
LAB_ARTIFACT_ROOT=__APPROVED_TEST_ARTIFACT_ROOT_COMMON_TO_INSTANCES__
LAB_ARTIFACT_RETENTION_DAYS=__DECIDE_RETENTION__
LAB_OIDC_ISSUER=__DECIDE_TEST_ISSUER__
LAB_OIDC_AUDIENCE=__DECIDE_TEST_AUDIENCE__
LAB_OIDC_PUBLIC_KEY_FILE=__CONTROLLED_TEST_PUBLIC_KEY_FILE__
LAB_OIDC_ALGORITHMS=__DECIDE_APPROVED_ASYMMETRIC_ALGORITHM__
LAB_OIDC_TENANT_CLAIM=__DECIDE_TENANT_CLAIM__
LAB_OIDC_ROLES_CLAIM=__DECIDE_ROLES_CLAIM__
LAB_AUDIT_HASH_KEY=__INJECT_AUDIT_HASH_KEY_AT_RUNTIME_MIN_32_BYTES__
LAB_INSTANCE_ID=__UNIQUE_PER_INSTANCE_LABEL__
# api_key+oidc, if separately selected, also needs LAB_API_KEY_PEPPER injected
# at runtime. No actual pepper/token/password/private key belongs in this file.
# PostgreSQL tenants must be provisioned separately; LAB_TENANT_ID does not
# bootstrap them. There is no current worker/rotation/leeway env configuration.
